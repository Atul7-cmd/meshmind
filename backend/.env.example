# Copy this file to .env and fill in your key. .env is git-ignored. Never commit it.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Model names change; confirm the current one in Google's Gemini API docs.
GEMINI_MODEL=gemini-3.6-flash

# Optional. Seconds to wait for Gemini (5-120).
GEMINI_TIMEOUT_SECONDS=30

# Optional. Comma-separated browser origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
